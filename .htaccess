DirectoryIndex index.php

# ----------------------------------------
# Force HTTPS (must be FIRST)
# ----------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fix Afrihost non-www /index.php access issue
RewriteCond %{HTTP_HOST} ^data-tshwane-ai\.co\.za$ [NC]
RewriteCond %{REQUEST_URI} ^/index\.php$ [NC]
RewriteRule ^$ https://data-tshwane-ai.co.za/ [L,R=301]

# ----------------------------------------
# Fix Afrihost www/index.php alias issue
# ----------------------------------------
RewriteCond %{HTTP_HOST} ^www\.data-tshwane-ai\.co\.za$ [NC]
RewriteCond %{REQUEST_URI} ^/index\.php$ [NC]
RewriteRule ^$ https://www.data-tshwane-ai.co.za/ [L,R=301]

# Allow direct access to index.php (required on Afrihost)
<Files "index.php">
    Require all granted
</Files>

# ----------------------------------------
# Front Controller (PHP Framework Routing)
# ----------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# ----------------------------------------
# Security Headers
# ----------------------------------------
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "DENY"
Header set X-XSS-Protection "1; mode=block"

# ----------------------------------------
# Compression for Performance
# ----------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# ----------------------------------------
# PHP Production Settings
# ----------------------------------------
php_flag display_errors Off
php_flag log_errors On
php_value error_log logs/php_error.log

